<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
 <FrameLayout android:id="@+id/widget_root" android:layout_width="180dp" android:layout_height="126dp" android:layout_gravity="center" android:background="@drawable/widget_asr" android:clipToOutline="true">
  <ImageView android:id="@+id/widget_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_scene_day" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
   <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT ATHAN" android:textSize="9sp" android:letterSpacing="0.15" android:includeFontPadding="false" />
   <TextView android:id="@+id/widget_prayer" android:layout_width="120dp" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Asr" android:textSize="28sp" android:fontFamily="serif" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
   <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3:47 PM" android:textSize="15sp" android:includeFontPadding="false" />
   <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:format="• In %s" android:includeFontPadding="false" />
   <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
  </LinearLayout>
  <TextView android:id="@+id/widget_reflection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginLeft="12dp" android:layout_marginRight="8dp" android:layout_marginBottom="7dp" android:text="≋  A moment to slow down." android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" />
 </FrameLayout>
</FrameLayout>