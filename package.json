    "adhan": "4.4.6",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^24.0.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
